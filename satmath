def solve_radical_equation():
    clear_screen()
    print("Solve sqrt(ax + b) = cx + d")
    a = get_float("a = "); b = get_float("b = "); c = get_float("c = "); d = get_float("d = ")
    A = c*c; B = 2*c*d - a; C = d*d - b
    print("Squaring both sides gives quadratic:")
    print("  {}x^2 + {}x + {} = 0".format(A, B, C))
    if A == 0:
        if B == 0: print("No solution or trivial.")
        else:
            x = -C / B
            left = math.sqrt(a*x + b); right = c*x + d
            if abs(left - right) < 1e-9:
                print("Valid solution: x = {}".format(x))
            else:
                print("Candidate x = {} is extraneous (left={}, right={}). No solution.".format(x, left, right))
    else:
        disc = B*B - 4*A*C
        if disc < 0: print("No real solutions.")
        else:
            sq = math.sqrt(disc)
            x1 = (-B + sq)/(2*A); x2 = (-B - sq)/(2*A)
            sols = []
            for x in [x1, x2]:
                if a*x + b >= 0 and c*x + d >= 0:
                    left = math.sqrt(a*x + b); right = c*x + d
                    if abs(left - right) < 1e-9:
                        sols.append(x)
                    else: print("x = {} is extraneous (left={}, right={})".format(x, left, right))
                else: print("x = {} invalid (negative under sqrt or RHS negative).".format(x))
            if sols: print("Valid solutions: {}".format(sols))
            else: print("No valid solutions after checking extraneous.")
    wait()

