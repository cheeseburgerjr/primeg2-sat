def solve_linear_one_var():
    clear_screen()
    print("Solve: ax + b = cx + d")
    a = get_float("a = "); b = get_float("b = "); c = get_float("c = "); d = get_float("d = ")
    coeff = a - c
    const = d - b
    print("\nStep-by-step:")
    show_step("Original", "{}x + {} = {}x + {}".format(a, b, c, d))
    show_step("Subtract cx", "({})x + {} = {}".format(a-c, b, d))
    show_step("Subtract b", "({})x = {}".format(a-c, d - b))
    if coeff == 0:
        if const == 0:
            print("Infinite solutions (identity).")
        else:
            print("No solution (contradiction).")
    else:
        x = const / coeff
        show_step("Divide", "x = {} / {} = {}".format(const, coeff, x))
        print("\nFinal answer: x = {}".format(x))
    wait()

