    factors = []; temp = n; d = 2
    while d*d <= temp:
        while temp % d == 0:
            factors.append(d); temp //= d
        d += 1
    if temp > 1: factors.append(temp)
    print("{} = {}".format(n, ' * '.join(map(str, factors))))
