def universal_equation_solver():
    clear_screen()
    print("Enter an equation using 'x' as variable.")
    print("Examples: 2x + 5 = 17, x^2 - 5x + 6 = 0, sqrt(x+5)=7, |2x-3|=9")
    eq = input("Equation: ").replace(" ", "").replace("√", "sqrt")
    if "=" not in eq:
        print("Equation must contain '='."); wait(); return
    lhs, rhs = eq.split("=", 1)
    try:
        if "|" in eq: solve_abs_from_string(lhs, rhs)
        elif "sqrt" in eq: solve_radical_from_string(lhs, rhs)
        elif "x^2" in eq or "x**2" in eq: solve_quadratic_from_string(lhs, rhs)
        elif "/" in eq and "x" in eq.split("/")[1]: solve_rational_from_string(lhs, rhs)
        elif "x" in eq: solve_linear_from_string(lhs, rhs)
        else: print("Could not recognize equation type.")
    except ValueError as e: print("Error:", e)
    wait()

def solve_linear_from_string(lhs, rhs):
    def f(x): return safe_eval(lhs, x) - safe_eval(rhs, x)
    val0 = f(0); val1 = f(1)
    a = val1 - val0; b = val0
    if a == 0:
        if b == 0: print("Infinite solutions.")
        else: print("No solution.")
    else:
        x = -b / a
        print("Linear equation: ax + b = 0 with a={}, b={}".format(a, b))
        print("x = {}".format(x))

def solve_quadratic_from_string(lhs, rhs):
    def f(x): return safe_eval(lhs.replace("x^2","x*x").replace("x**2","x*x"), x) - safe_eval(rhs.replace("x^2","x*x").replace("x**2","x*x"), x)
    val0 = f(0); val1 = f(1); val_1 = f(-1)
    c = val0
    a_plus_b = val1 - c; a_minus_b = val_1 - c
    a = (a_plus_b + a_minus_b)/2; b = a_plus_b - a
    if a == 0:
        print("Not a quadratic (a=0). Solving as linear.")
        if b == 0: print("Constant equation.")
        else: print("x = {}".format(-c/b))
    else:
        disc = b*b - 4*a*c
        print("Quadratic: {}x^2 + {}x + {} = 0".format(a, b, c))
        print("Discriminant = {}".format(disc))
        if disc < 0: print("No real solutions.")
        elif disc == 0: print("x = {}".format(-b/(2*a)))
        else:
            sq = math.sqrt(disc)
            x1 = (-b + sq)/(2*a); x2 = (-b - sq)/(2*a)
            print("x1 = {}, x2 = {}".format(x1, x2))

def solve_radical_from_string(lhs, rhs):
    left = lhs.strip(); right = rhs.strip()
    start = left.find("sqrt(") if "sqrt(" in left else left.find("√(")
    if start == -1: raise Exception("No sqrt found")
    inner_start = start + 5 if "sqrt(" in left else start + 2
    count = 1; i = inner_start
    while i < len(left) and count > 0:
        if left[i] == '(': count += 1
        elif left[i] == ')': count -= 1
        i += 1
    inner = left[inner_start:i-1]
    def f_inner(x): return safe_eval(inner, x)
    a = f_inner(1) - f_inner(0); b = f_inner(0)
    def f_right(x): return safe_eval(right, x)
    c_val = f_right(1) - f_right(0); d_val = f_right(0)
    A = c_val*c_val; B = 2*c_val*d_val - a; C = d_val*d_val - b
    disc = B*B - 4*A*C
    print("Under radical: {}x+{}, RHS: {}x+{}".format(a, b, c_val, d_val))
    print("Squaring gives {}x^2 + {}x + {} = 0".format(A, B, C))
    if disc < 0: print("No real solutions.")
    else:
        sq = math.sqrt(disc)
        x1 = (-B+sq)/(2*A) if A != 0 else -C/B
        x2 = (-B-sq)/(2*A) if A != 0 else None
        for x in [x1, x2]:
            if x is None: continue
            if a*x+b >= 0 and c_val*x+d_val >= 0:
                leftv = math.sqrt(a*x+b); rightv = c_val*x+d_val
                if abs(leftv - rightv) < 1e-9:
                    print("Valid solution: x = {}".format(x))
                else: print("Extraneous: x = {}".format(x))
            else: print("Invalid domain: x = {}".format(x))

def solve_abs_from_string(lhs, rhs):
    start = lhs.find("|"); end = lhs.rfind("|")
    if start == -1 or end == -1: raise ValueError("Could not find absolute value bars.")
    inner = lhs[start+1:end]
    c = safe_eval(rhs, 0)
    if c < 0: print("No solution (abs cannot equal negative).")
    elif c == 0:
        def f(x): return safe_eval(inner, x)
        a = f(1)-f(0); b = f(0)
        if a == 0:
            if b == 0: print("All x")
            else: print("No solution")
        else: print("x = {}".format(-b/a))
    else:
        def f(x): return safe_eval(inner, x)
        for sign, target in [("positive", c), ("negative", -c)]:
            a = (f(1)-target) - (f(0)-target); b = f(0) - target
            if a == 0:
                if b == 0: print("All x satisfy |...| = {}?")
                else: pass
            else: print("Case {}: x = {}".format(sign, -b/a))

